#!/usr/bin/env bash
set -euo pipefail

git fetch -p
current=$(cd "$(git rev-parse --show-toplevel)" && pwd -P)
refs=$(git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads)
paths=()
branches=()
locks=()
i=-1
while IFS= read -r -d '' field; do
  case "$field" in
    'worktree '*)
      i=$((i + 1))
      paths[i]=${field#worktree }
      branches[i]=''
      locks[i]=''
      ;;
    'branch '*) branches[i]=${field#branch refs/heads/} ;;
    locked|locked\ *) locks[i]=locked ;;
  esac
done < <(git worktree list --porcelain -z)

for ((i = 1; i < ${#paths[@]}; i++)); do
  path=${paths[i]}
  [[ -z "${locks[i]}" ]] || continue
  [[ "$(cd "$path" && pwd -P)" != "$current" ]] || continue
  status=$(git -C "$path" status --porcelain)
  if [[ -z "$status" ]] && git worktree remove -- "$path"; then
    branches[i]=''
  fi
done

while read -r branch track; do
  [[ "$track" == '[gone]' ]] || continue
  skip=false
  for ((i = 0; i < ${#paths[@]}; i++)); do
    [[ "${branches[i]}" == "$branch" ]] || continue
    skip=true
    break
  done
  if "$skip"; then
    printf 'Skipped %s: protected or dirty worktree\n' "$branch"
  else
    git branch -D -- "$branch"
  fi
done <<< "$refs"
